# toolagent — copy to .env, fill in what you use, then: set -a; . ./.env; set +a
# toolagent run / eval / toolbench (Claude):
ANTHROPIC_API_KEY=
# Optional, for --otlp (requirements-otel.txt): where to send spans
OTEL_SERVICE_NAME=toolagent
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional, for toolagent toolbench: the StableToolBench server's key, if it checks one
TOOLBENCH_KEY=
